{
  "items": [
    {
      "name": "KindleAir",
      "items": [
        {
          "name": "Start AirPlay receiver",
          "action": "./kindleair.sh",
          "params": "start",
          "exitmenu": true,
          "priority": 10
        },
        {
          "name": "Stop AirPlay receiver",
          "action": "./kindleair.sh",
          "params": "stop",
          "priority": 20
        },
        {
          "name": "Pair Bluetooth speaker",
          "action": "./kindleair.sh",
          "params": "bluetooth",
          "exitmenu": true,
          "priority": 30
        },
        {
          "name": "Resync audio / clear delay",
          "action": "./kindleair.sh",
          "params": "resync",
          "priority": 40
        },
        {
          "name": "Status",
          "action": "./kindleair.sh",
          "params": "status",
          "priority": 50
        },
        {
          "name": "Collect diagnostics",
          "action": "./kindleair.sh",
          "params": "diagnose",
          "priority": 60
        },
        {
          "name": "Settings",
          "priority": 70,
          "items": [
            {
              "name": "Low power mode: On (tap to turn off)",
              "action": "./kindleair.sh",
              "params": "power-normal",
              "refresh": true,
              "exitmenu": false,
              "status": false,
              "if": "\"/mnt/us/extensions/kindleair/low-power.conf\" \"1\" -gg",
              "priority": 10
            },
            {
              "name": "Low power mode: Off (tap to turn on)",
              "action": "./kindleair.sh",
              "params": "power-low",
              "refresh": true,
              "exitmenu": false,
              "status": false,
              "if": "\"/mnt/us/extensions/kindleair/low-power.conf\" \"1\" -gg !",
              "priority": 10
            },
            {
              "name": "Keep awake: On (tap to allow sleep)",
              "action": "./kindleair.sh",
              "params": "sleep-off",
              "refresh": true,
              "exitmenu": false,
              "status": false,
              "if": "\"/mnt/us/extensions/kindleair/keep-awake.conf\" -e ! \"/mnt/us/extensions/kindleair/keep-awake.conf\" \"1\" -gg ||",
              "priority": 20
            },
            {
              "name": "Keep awake: Off (tap to keep awake)",
              "action": "./kindleair.sh",
              "params": "sleep-on",
              "refresh": true,
              "exitmenu": false,
              "status": false,
              "if": "\"/mnt/us/extensions/kindleair/keep-awake.conf\" -e ! \"/mnt/us/extensions/kindleair/keep-awake.conf\" \"1\" -gg || !",
              "priority": 20
            },
            {
              "name": "Auto sleep: On (tap to turn off)",
              "action": "./kindleair.sh",
              "params": "idle-toggle",
              "refresh": true,
              "exitmenu": false,
              "status": false,
              "if": "\"/mnt/us/extensions/kindleair/idle-timer.conf\" \"^[1-9]\" -gg",
              "priority": 30
            },
            {
              "name": "Auto sleep: Off (tap to turn on)",
              "action": "./kindleair.sh",
              "params": "idle-toggle",
              "refresh": true,
              "exitmenu": false,
              "status": false,
              "if": "\"/mnt/us/extensions/kindleair/idle-timer.conf\" \"^[1-9]\" -gg !",
              "priority": 30
            },
            {
              "name": "Auto sleep delay",
              "priority": 40,
              "items": [
                {
                  "name": "Off",
                  "action": "./kindleair.sh",
                  "params": "idle-minutes 0",
                  "refresh": true,
                  "exitmenu": false,
                  "status": false,
                  "priority": 10
                },
                {
                  "name": "1 minute",
                  "action": "./kindleair.sh",
                  "params": "idle-minutes 1",
                  "refresh": true,
                  "exitmenu": false,
                  "status": false,
                  "priority": 20
                },
                {
                  "name": "5 minutes",
                  "action": "./kindleair.sh",
                  "params": "idle-minutes 5",
                  "refresh": true,
                  "exitmenu": false,
                  "status": false,
                  "priority": 30
                },
                {
                  "name": "10 minutes",
                  "action": "./kindleair.sh",
                  "params": "idle-minutes 10",
                  "refresh": true,
                  "exitmenu": false,
                  "status": false,
                  "priority": 40
                },
                {
                  "name": "15 minutes",
                  "action": "./kindleair.sh",
                  "params": "idle-minutes 15",
                  "refresh": true,
                  "exitmenu": false,
                  "status": false,
                  "priority": 50
                },
                {
                  "name": "30 minutes",
                  "action": "./kindleair.sh",
                  "params": "idle-minutes 30",
                  "refresh": true,
                  "exitmenu": false,
                  "status": false,
                  "priority": 60
                },
                {
                  "name": "60 minutes",
                  "action": "./kindleair.sh",
                  "params": "idle-minutes 60",
                  "refresh": true,
                  "exitmenu": false,
                  "status": false,
                  "priority": 70
                },
                {
                  "name": "120 minutes",
                  "action": "./kindleair.sh",
                  "params": "idle-minutes 120",
                  "refresh": true,
                  "exitmenu": false,
                  "status": false,
                  "priority": 80
                }
              ]
            },
            {
              "name": "Show current settings",
              "action": "./kindleair.sh",
              "params": "settings-status",
              "priority": 50
            },
            {
              "name": "Restore normal power (recovery)",
              "action": "./kindleair.sh",
              "params": "normal-power",
              "priority": 60
            }
          ]
        }
      ]
    }
  ]
}
